<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        @page { margin: 0; }
        * {
            font-family: Arial, Helvetica, sans-serif;
            -webkit-box-sizing: border-box;
            box-sizing: border-box;
        }
        body {
            color: #000;
            margin: 0;
            padding: 0;
            font-size: 8.5px;
            line-height: 1.1;
            width: 100%;
        }
        
        /* Contenedor centrado con márgenes de seguridad iguales */
        .container {
            width: 94%;
            margin: 0 auto; /* Esto centra todo el bloque */
            padding: 10px 0;
        }

        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: bold; }
        .uppercase { text-transform: uppercase; }
        
        .separator {
            border: none;
            border-top: 1px dashed #000;
            margin: 4px 0;
            width: 100%;
        }
        
        table { 
            width: 100%; 
            border-collapse: collapse; 
            table-layout: fixed; 
        }
        td { vertical-align: top; padding: 1px 0; word-wrap: break-word; }
        
        .company-name { font-size: 10px; font-weight: bold; margin-bottom: 1px; }
        
        .doc-header {
            width: 100%;
            margin: 4px 0;
            padding: 3px 0;
            border-top: 1px solid #000;
            border-bottom: 1px solid #000;
        }

        /* Columnas de items */
        .col-cant { width: 15%; }
        .col-desc { width: 55%; }
        .col-total { width: 30%; }

        /* Columnas de totales */
        .totals-table td.label { width: 65%; }
        .totals-table td.amount { width: 35%; }
        
        .total-row td {
            font-size: 10px;
            font-weight: bold;
            border-top: 1px double #000;
            padding-top: 2px;
        }
        
        .qr-section { margin-top: 8px; text-align: center; }
        .qr-section img { width: 90px; height: 90px; }
        
        .footer-text { font-size: 7.5px; margin-top: 5px; text-align: center; }
        .hash { font-family: monospace; font-size: 6.5px; word-break: break-all; margin-bottom: 4px;}
    </style>
</head>
<body>
    <div class="container">
        {% set cp = doc.company %}
        {% set cl = doc.client %}
        {% set moneda = doc.tipoMoneda|catalog('02') %}
        {% set name = doc.tipoDoc|catalog('01') %}

        <!-- LOGO Y DATOS EMPRESA -->
        <div class="center">
            {% if params.system.logo %}
                <img src="{{ params.system.logo|image_b64 }}" style="max-height: 48px; max-width: 150px; margin-bottom: 5px;">
            {% endif %}
            <div class="company-name uppercase">{{ cp.razonSocial }}</div>
            <div class="bold">RUC: {{ cp.ruc }}</div>
            <div style="font-size: 7.5px;">{{ cp.address.direccion|upper }}</div>
            <div style="font-size: 7.5px;">{{ cp.address.distrito|upper }} - {{ cp.address.provincia|upper }}</div>
        </div>

        <div class="center doc-header">
            <div class="bold uppercase">{{ name }} ELECTRÓNICA</div>
            <div class="bold" style="font-size: 10px;">{{ doc.serie }}-{{ doc.correlativo }}</div>
        </div>

        <!-- DATOS DEL CLIENTE -->
        <table>
            <tr><td style="width: 20%; font-weight: bold;">FECHA:</td><td>{{ doc.fechaEmision|date('d/m/Y H:i') }}</td></tr>
            <tr><td style="font-weight: bold;">CLIENTE:</td><td class="uppercase">{{ cl.rznSocial }}</td></tr>
            <tr><td style="font-weight: bold;">{{ cl.tipoDoc|catalog('06')|upper }}:</td><td>{{ cl.numDoc }}</td></tr>
            {% if cl.address and cl.address.direccion %}
            <tr><td style="font-weight: bold;">DIR.:</td><td class="uppercase">{{ cl.address.direccion }}</td></tr>
            {% endif %}
        </table>

        <div class="separator"></div>

        <!-- DETALLE DE PRODUCTOS -->
        <table>
            <thead>
                <tr>
                    <th class="col-cant" style="text-align:left;">CANT.</th>
                    <th class="col-desc" style="text-align:left;">DESCRIPCIÓN</th>
                    <th class="col-total" style="text-align:right;">TOTAL</th>
                </tr>
            </thead>
            <tbody>
                {% for det in doc.details %}
                <tr>
                    <td>{{ (det.cantidad|default(0))|n_format }}</td>
                    <td>
                        <div class="uppercase bold">{{ det.descripcion }}</div>
                        <div style="font-size: 7.5px; color: #333;">P.U: {{ moneda }} {{ (det.mtoPrecioUnitario|default(0))|n_format }}</div>
                    </td>
                    <td class="right">{{ moneda }} {{ (det.mtoImpVenta|default(0))|n_format }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <!-- TOTALES -->
        <div style="margin-top: 5px;">
            <table class="totals-table">
                {% if (doc.mtoOperGravadas|default(0)) > 0 %}
                <tr>
                    <td class="right label">OP. GRAVADA:</td>
                    <td class="right amount">{{ moneda }} {{ (doc.mtoOperGravadas|default(0))|n_format }}</td>
                </tr>
                {% endif %}
                {% if (doc.mtoIGV|default(0)) > 0 %}
                <tr>
                    <td class="right label">I.G.V. (18%):</td>
                    <td class="right amount">{{ moneda }} {{ (doc.mtoIGV|default(0))|n_format }}</td>
                </tr>
                {% endif %}
                <tr class="total-row">
                    <td class="right label">TOTAL:</td>
                    <td class="right amount">{{ moneda }} {{ (doc.mtoImpVenta|default(0))|n_format }}</td>
                </tr>
            </table>
        </div>

        <div style="font-size: 7.5px; margin-top: 4px;">
            {% if doc.legends %}<strong>SON:</strong> {{ legend(doc.legends, '1000')|upper }}{% endif %}
        </div>

        <div class="separator"></div>

        <!-- QR Y PIE DE PÁGINA SUNAT -->
        <div class="qr-section">
            <img src="{{ qrCode(doc)|image_b64('svg+xml') }}">
            {% if params.system.hash %}
                <div class="hash"><b>HASH:</b> {{ params.system.hash }}</div>
            {% endif %}
        </div>

        <div class="footer-text">
            Representación impresa de la <b>{{ name }} Electrónica</b><br>
            Consulte su documento en: <b>www.sunat.gob.pe</b><br>
            ¡GRACIAS POR SU PREFERENCIA!
        </div>
    </div>
</body>
</html>
