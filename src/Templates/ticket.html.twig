<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        @page { margin: 0; }
        body {
            font-family: 'Arial', sans-serif;
            color: #1e293b;
            margin: 0;
            padding: 8px;
            font-size: 9px;
            line-height: 1.3;
            width: 100%;
        }
        .center { text-align: center; }
        .right { text-align: right; }
        .bold { font-weight: 700; }
        .separator {
            border: none;
            border-top: 1px dashed #94a3b8;
            margin: 6px 0;
        }
        .separator-double {
            border: none;
            border-top: 2px solid #334155;
            margin: 8px 0;
        }
        table { width: 100%; border-collapse: collapse; }
        td { vertical-align: top; padding: 1px 0; }
        .label { color: #64748b; font-size: 8px; }
        .company-name {
            font-size: 12px;
            font-weight: 800;
            margin: 4px 0;
        }
        .doc-type {
            font-size: 10px;
            font-weight: 700;
            border: 1px solid #334155;
            padding: 4px;
            margin: 6px 0;
            display: inline-block;
        }
        .doc-number {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
        }
        .items-table td {
            padding: 3px 0;
            border-bottom: 1px dotted #cbd5e1;
        }
        .items-table th {
            font-size: 8px;
            text-transform: uppercase;
            color: #64748b;
            border-bottom: 1px solid #334155;
            padding: 3px 0;
        }
        .total-final {
            font-size: 13px;
            font-weight: 800;
        }
        .qr-section {
            margin-top: 8px;
            text-align: center;
        }
        .hash-text {
            font-family: monospace;
            font-size: 7px;
            color: #94a3b8;
            word-break: break-all;
        }
    </style>
</head>
<body>
    {% set cp = doc.company %}
    {% set cl = doc.client %}
    {% set moneda = doc.tipoMoneda|catalog('02') %}
    {% set name = doc.tipoDoc|catalog('01') %}

    <!-- CABECERA -->
    <div class="center">
        {% if params.system.logo %}
            <img src="{{ params.system.logo|image_b64 }}" height="35" style="margin-bottom: 4px;">
        {% endif %}
        <div class="company-name">{{ cp.razonSocial }}</div>
        <div class="label">RUC: {{ cp.ruc }}</div>
        <div class="label">{{ cp.address.direccion }}</div>
    </div>

    <hr class="separator-double">

    <!-- TIPO Y NRO DE DOCUMENTO -->
    <div class="center">
        <span class="doc-type">{{ name|upper }} ELECTRÓNICA</span><br>
        <span class="doc-number">{{ doc.serie }}-{{ doc.correlativo }}</span>
    </div>

    <hr class="separator">

    <!-- DATOS DEL CLIENTE -->
    <table>
        <tr>
            <td class="label">Cliente:</td>
            <td>{{ cl.rznSocial }}</td>
        </tr>
        <tr>
            <td class="label">{{ cl.tipoDoc|catalog('06') }}:</td>
            <td>{{ cl.numDoc }}</td>
        </tr>
        <tr>
            <td class="label">Fecha:</td>
            <td>{{ doc.fechaEmision|date('d/m/Y H:i') }}</td>
        </tr>
    </table>

    <hr class="separator">

    <!-- DETALLE DE ITEMS -->
    <table class="items-table">
        <thead>
            <tr>
                <th style="text-align:left;">Cant.</th>
                <th style="text-align:left;">Descripción</th>
                <th class="right">P.U.</th>
                <th class="right">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for det in doc.details %}
            <tr>
                <td>{{ det.cantidad|n_format }}</td>
                <td>{{ det.descripcion }}</td>
                <td class="right">{{ det.mtoValorUnitario|n_format }}</td>
                <td class="right">{{ det.mtoValorVenta|n_format }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <hr class="separator-double">

    <!-- TOTALES -->
    <table>
        <tr>
            <td class="right label">Op. Gravada:</td>
            <td class="right" style="width:80px;">{{ moneda }} {{ doc.mtoOperGravadas|n_format }}</td>
        </tr>
        <tr>
            <td class="right label">I.G.V. (18%):</td>
            <td class="right">{{ moneda }} {{ doc.mtoIGV|n_format }}</td>
        </tr>
    </table>
    <table>
        <tr>
            <td class="right total-final">TOTAL: {{ moneda }} {{ doc.mtoImpVenta|n_format }}</td>
        </tr>
    </table>

    {% if doc.legends %}
    <hr class="separator">
    <div style="font-size: 7px; color: #64748b;">
        <strong>SON:</strong> {{ legend(doc.legends, '1000') }}
    </div>
    {% endif %}

    <hr class="separator">

    <!-- QR Y HASH -->
    <div class="qr-section">
        <img src="{{ qrCode(doc)|image_b64('svg+xml') }}" width="90">
    </div>

    <div class="center hash-text" style="margin-top: 4px;">
        {% if params.system.hash %}Hash: {{ params.system.hash }}<br>{% endif %}
        Representación impresa de {{ name|upper }} ELECTRÓNICA
        {% if params.user.resolucion %}<br>{{ params.user.resolucion }}{% endif %}
    </div>

</body>
</html>
