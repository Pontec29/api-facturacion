<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <style type="text/css">
        body {
            font-family: Arial, sans-serif !important;
            color: #000;
            background-color: white;
            margin: 0;
            padding: 0;
            line-height: 1.2;
            font-size: 11px;
        }

        .container {
            padding: 25px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        td {
            vertical-align: top;
            word-wrap: break-word;
        }

        /* HEADER */
        .company-name {
            font-size: 18px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .document-box {
            border: 1px solid #000;
            padding: 10px;
            text-align: center;
            border-radius: 4px;
        }

        /* INFO CLIENTE CORREGIDA */
        .info-table td {
            padding-bottom: 4px; 
        }
        .label-cell {
            font-weight: bold;
        }

        /* TABLA DE ITEMS */
        .items-table th {
            background-color: #f2f2f2;
            border-bottom: 1px solid #000;
            padding: 6px;
            font-size: 10px;
            text-align: left;
        }

        .items-table td {
            border-bottom: 1px solid #eee;
            padding: 6px;
        }

        /* TOTALES - LIMPIO Y SIN SOMBREADO */
        .totals-table td {
            padding: 4px 8px;
            text-align: right;
        }

        .total-row td {
            border-top: 1px solid #000; /* Línea normal, no gruesa */
            color: #000;
            font-size: 14px;
            /* Se retiró el font-weight: bold; */
            padding-top: 8px;
        }

        .qr-table {
            margin-top: 30px;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }

        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .bold { font-weight: bold; }

        /* MARCA DE AGUA PARA ANULADO */
        .watermark {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-45deg);
            font-size: 100px;
            color: rgba(255, 0, 0, 0.15);
            font-weight: bold;
            z-index: -1000;
            white-space: nowrap;
            pointer-events: none;
        }
    </style>
</head>
<body>
    {% if params.user.estado == 'ANULADO' %}
        <div class="watermark">ANULADO</div>
    {% endif %}
    
    {% set cp = doc.company %}
    {% set cl = doc.client %}
    {% set moneda = doc.tipoMoneda|catalog('02') %}
    {% set name = doc.tipoDoc|catalog('01') %}

    <div class="container">
        <!-- CABECERA -->
        <table>
            <tr>
                <td width="20%">
                    {% if params.system.logo %}
                        <img src="{{ params.system.logo|image_b64 }}" style="max-width: 150px; max-height: 70px;">
                    {% endif %}
                </td>
                <td width="50%" style="padding: 0 10px; text-align: center;"> <!-- TEXTO CENTRADO -->
                    <div class="company-name">{{ cp.nombreComercial|default('', true) is empty ? cp.razonSocial : cp.nombreComercial }}</div>
                    <div style="font-size: 10px; color: #333; margin-top: 3px;">
                        <strong>RUC: {{ cp.ruc }}</strong><br>
                        {{ cp.address.direccion }}<br>
                        {{ params.user.header|raw }}
                    </div>
                </td>
                <td width="30%">
                    <div class="document-box">
                        <div style="font-size: 11px;">RUC {{ cp.ruc }}</div>
                        <span style="font-size: 13px; font-weight: bold; margin: 5px 0; display: block;">
                            {{ name|default('NOTA DE VENTA')|upper }}
                            {% if doc.tipoDoc == '01' or doc.tipoDoc == '03' %}
                                ELECTRÓNICA
                            {% endif %}
                        </span>
                        <div style="font-size: 15px; font-weight: bold;">{{ doc.serie }}-{{ doc.correlativo }}</div>
                    </div>
                </td>
            </tr>
        </table>
        
        <!-- INFO CLIENTE - SE RETIRÓ EL TÍTULO -->
        <table class="info-table" style="width: 100%; margin-top: 15px; border-top: 1px solid #ccc; padding-top: 10px;">
            <tr>
                <!-- Columna Izquierda -->
                <td class="label-cell" style="width: 12%;">CLIENTE</td>
                <td style="width: 2%;">:</td>
                <td style="width: 48%;">{{ cl.rznSocial|upper }}</td>
                
                <!-- Columna Derecha -->
                <td class="label-cell" style="width: 10%;">FECHA</td>
                <td style="width: 2%;">:</td>
                <td style="width: 26%;">{{ doc.fechaEmision|date('d/m/Y H:i') }}</td>
            </tr>
            <tr>
                <td class="label-cell">{{ cl.tipoDoc|catalog('06') }}</td>
                <td>:</td>
                <td>{{ cl.numDoc }}</td>
                
                <td class="label-cell">MONEDA</td>
                <td>:</td>
                <td>{{ doc.tipoMoneda|catalog('021')|upper }}</td>
            </tr>
            <tr>
                <td class="label-cell">DIRECCIÓN</td>
                <td>:</td>
                <td>{{ cl.address ? cl.address.direccion|upper : '-' }}</td>
                
                <td class="label-cell">PAGO</td>
                <td>:</td>
                <td>{{ doc.formaPago ? doc.formaPago.tipo|upper : 'CONTADO' }}</td>
            </tr>
            <tr>
                <td class="label-cell">CAJERO</td>
                <td>:</td>
                <td>{{ params.user.usuario_nombre_a4|upper }}</td>
                
                <td class="label-cell"></td>
                <td></td>
                <td></td>
            </tr>
        </table>

        <!-- ITEMS -->
        <div style="margin-top: 15px;">
            <table class="items-table">
                <thead>
                    <tr>
                        <th width="10%" class="text-center">CANT.</th>
                        <th width="10%" class="text-center">U.M.</th>
                        <th width="15%" class="text-center">CÓDIGO</th> <!-- NUEVA COLUMNA -->
                        <th width="35%">DESCRIPCIÓN</th>
                        <th width="15%" class="text-right">P. UNIT</th>
                        <th width="15%" class="text-right">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    {% for det in doc.details %}
                    <tr>
                        <td class="text-center">{{ det.cantidad|n_format }}</td>
                        <td class="text-center">{{ det.unidad }}</td>
                        <td class="text-center">{{ det.codProducto|default('-') }}</td> <!-- DATO DE CÓDIGO -->
                        <td>
                            <div class="bold">{{ det.descripcion }}</div>
                        </td>
                        <td class="text-right">{{ (det.mtoPrecioUnitario|default(0))|n_format }}</td>
                        <td class="text-right"><strong>{{ (det.mtoValorVenta + det.igv)|n_format }}</strong></td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- TOTALES -->
        <table style="margin-top: 15px;">
            <tr>
                <td width="60%">
                    <div style="font-size: 10px;">
                        <strong>SON:</strong> {{ legend(doc.legends, '1000') }}
                    </div>
                </td>
                <td width="40%">
                    <table class="totals-table">
                        <tr>
                            <td>Op. Gravada:</td>
                            <td>{{ moneda }} {{ (doc.mtoOperGravadas|default(0))|n_format }}</td>
                        </tr>
                        <tr>
                            <td>I.G.V. (18%):</td>
                            <td>{{ moneda }} {{ (doc.mtoIGV|default(0))|n_format }}</td>
                        </tr>
                        <tr class="total-row"> <!-- SIN NEGRITA -->
                            <td>TOTAL:</td>
                            <td>{{ moneda }} {{ (doc.mtoImpVenta|default(0))|n_format }}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- PIE DE PÁGINA -->
        {% if doc.tipoDoc == '01' or doc.tipoDoc == '03' %}
        <table class="qr-table">
            <tr>
                <td width="15%">
                    <img src="{{ qrCode(doc)|image_b64('svg+xml') }}" width="85">
                </td>
                <td width="85%" style="padding-left: 10px; font-size: 9px; color: #444;">
                    {% if params.system.hash %}<strong>HASH:</strong> {{ params.system.hash }}<br>{% endif %}
                    Representación impresa de la {{ name|upper }} ELECTRÓNICA.<br>
                    Consulte la validez en: {{ params.user.url_consulta|default('www.sunat.gob.pe') }}<br>
                    {{ params.user.resolucion|default('Autorizado mediante resolución de SUNAT.') }}
                </td>
            </tr>
        </table>
        {% else %}
        <div style="margin-top: 30px; border-top: 1px solid #eee; padding-top: 15px; text-align: center; font-size: 10px; color: #555;">
            <strong>ESTE DOCUMENTO NO ES UN COMPROBANTE DE PAGO.</strong><br>
            Solo válido para control interno.
        </div>
        {% endif %}
    </div>
</body>
</html>
