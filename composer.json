{
    "name": "pontec/pos-2026-facturacion",
    "description": "Microservicio de facturación electrónica con Greenter para POS-2026",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.0",
        "greenter/greenter": "^5.2",
        "greenter/report": "^5.0",
        "monolog/monolog": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "audit": {
            "block-insecure": false,
            "ignore": {"*": "*"}
        }
    }
}
